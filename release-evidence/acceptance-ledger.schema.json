{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinking-machine-observatory.example/schemas/acceptance-ledger-1.0.0.json",
  "title": "Thinking Machine Observatory acceptance ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "profileVersion", "source", "groups"],
  "properties": {
    "$schema": { "type": "string" },
    "profileVersion": { "const": "1.0.0" },
    "source": { "const": "docs/07-acceptance-criteria-and-test-plan.md" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "severity": { "enum": ["launch-blocking", "advisory", "not-applicable"] },
    "path": { "enum": ["illustrative", "verified-wasm", "webgpu", "secondary", "release"] },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "paths"],
      "properties": {
        "id": { "type": "string", "pattern": "^TMO-[A-Z0-9]+-[0-9]{3}$" },
        "requirement": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "severityReason": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "defaultSeverity", "severityReason", "criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "defaultSeverity": { "$ref": "#/$defs/severity" },
        "severityReason": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        }
      }
    }
  }
}
