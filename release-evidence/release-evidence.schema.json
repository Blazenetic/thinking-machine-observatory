{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinking-machine-observatory.example/schemas/release-evidence-1.0.0.json",
  "title": "Thinking Machine Observatory release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "profileVersion", "candidate", "environments", "evidence"],
  "properties": {
    "$schema": { "type": "string" },
    "profileVersion": { "const": "1.0.0" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "environments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/environment" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "commit", "lockfile", "runtime"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "lockfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "pnpm-lock.yaml" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "packageManager"],
          "properties": {
            "node": { "type": "string", "minLength": 1 },
            "packageManager": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operatingSystem", "deviceClass", "capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "browser": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "deviceClass": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": { "enum": ["automated", "manual", "inspection", "user-study", "not-run"] },
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "comparison": { "enum": ["at-most", "at-least", "equal"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "criteria", "result", "method", "environments", "artifacts", "limitation"],
      "properties": {
        "id": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^TMO-[A-Z0-9]+-[0-9]{3}$" }
        },
        "result": { "enum": ["passed", "failed", "blocked", "not-run"] },
        "method": { "$ref": "#/$defs/method" },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "measurements": {
          "type": "array",
          "items": { "$ref": "#/$defs/measurement" }
        },
        "limitation": { "type": "string" },
        "reviewer": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
