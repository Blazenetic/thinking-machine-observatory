{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/app.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../../packages/domain" },
    { "path": "../../packages/sampler" },
    { "path": "../../packages/trace-schema" },
    { "path": "../../packages/instruments" },
    { "path": "../../packages/experiments" },
    { "path": "../../packages/inference-worker" }
  ]
}
