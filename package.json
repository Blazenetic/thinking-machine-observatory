{
  "name": "thinking-machine-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first laboratory for observing and intervening in next-token prediction.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @observatory/app build",
    "capture:evidence": "node scripts/capture-evidence.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm fixtures:check && pnpm trace:verify:live && pnpm payload:verify && pnpm phase3:verify && pnpm phase4:verify && pnpm test && pnpm build",
    "dev": "pnpm --filter @observatory/app dev",
    "e2e": "playwright test",
    "fixtures:check": "node --experimental-strip-types scripts/generate-fixtures.ts --check && node scripts/check-model-fixtures.mjs",
    "fixtures:generate": "node --experimental-strip-types scripts/generate-fixtures.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "model:golden:generate": "python model-tools/reference/generate_golden.py",
    "model:verify": "pnpm model:verify:wasm && pnpm model:verify:int8-rejection",
    "model:verify:int8-rejection": "node packages/inference-worker/scripts/verify-golden.mjs --variant int8 --expect-rejection",
    "model:verify:wasm": "node packages/inference-worker/scripts/verify-golden.mjs --variant fp32",
    "payload:verify": "node --experimental-strip-types scripts/verify-compact-payload.ts",
    "phase3:verify": "vitest run packages/trace-schema/src/compact.test.ts packages/trace-schema/src/notebook.test.ts packages/inference-worker/src/generation-controller.test.ts apps/observatory/src/data/live.test.ts",
    "phase4:verify": "vitest run packages/instruments/src/instruments.test.ts packages/experiments/src/experiments.test.ts packages/inference-worker/src/inference-worker.test.ts packages/trace-schema/src/compact.test.ts && node --experimental-strip-types scripts/verify-instrument-capabilities.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "trace:verify:live": "node --experimental-strip-types scripts/verify-live-trace.ts",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
